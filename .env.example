# Local Development: Copy this file to `.env` or `.env.local` (both are ignored by .gitignore).
# Production (Render): Set any required variables in Render Dashboard -> Environment -> Environment Variables.
# Note: Never hardcode API keys, tokens, or secrets in source code.

# GEMINI_API_KEY: Required only if Gemini AI API calls are used.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase (cloud sync) — required for the same ledger on every device.
# Create a project at https://supabase.com/dashboard, then copy from
# Project Settings -> API: Project URL + anon public key.
# Production (Render): set the same two variables in Render Dashboard ->
# Environment -> Environment Variables. Never commit real keys here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="YOUR_APP_URL"
