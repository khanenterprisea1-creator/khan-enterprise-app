# Local Development: Copy this file to `.env` or `.env.local` (both are ignored by .gitignore).
# Production (Render): Set any required variables in Render Dashboard -> Environment -> Environment Variables.
# Note: Never hardcode API keys, tokens, or secrets in source code.

# GEMINI_API_KEY: Required only if Gemini AI API calls are used.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="YOUR_APP_URL"
